ROOMX_TOKEN=
ROOMX_PORT=8422
# Address the port is published on. 127.0.0.1: only this machine, for an HTTPS proxy running here. 0.0.0.0: all networks.
ROOMX_BIND=127.0.0.1
# Optional: comma-separated origins that may call the API from another origin (scheme://host[:port]).
# Leave empty when the app is served by this server, same-origin needs no CORS.
ROOMX_ALLOWED_ORIGINS=
